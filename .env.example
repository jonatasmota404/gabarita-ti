# Copie para .env (raiz) e ajuste. Nada aqui é segredo de produção.

# --- API (apps/api) ---
PORT=3001
# Banco PRÓPRIO do app (usuários, respostas). Migrações via Prisma.
DATABASE_URL=postgresql://gabarita:gabarita@localhost:5436/gabarita
# Banco do provas-ti-ingest, SOMENTE LEITURA, com o role app_leitor (só SELECT nas views v_*).
# Local: aponta para a fixture do docker compose. Real: postgresql://app_leitor:<senha>@<host>:5435/provas_ti
INGEST_DATABASE_URL=postgresql://app_leitor:app_leitor_local@localhost:5436/ingest_dev
# Diretório com os PNGs dos recortes (caminho_relativo de v_questao_recorte é resolvido aqui).
# Absoluto, ou relativo ao diretório da API (apps/api), que é o cwd dela.
RECORTES_DIR=../../infra/ingest-fixture/recortes
# Gere um valor longo e aleatório: openssl rand -base64 48
JWT_SECRET=troque-isto-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d
# Origens liberadas no CORS (separadas por vírgula). O web usa proxy próprio e não precisa disto.
CORS_ORIGINS=http://localhost:3000

# --- Web (apps/web) ---
# URL da API vista pelo servidor Next (BFF). O navegador nunca fala direto com a API.
API_URL=http://localhost:3001

# --- Testes de integração ---
# Conexão administrativa usada para (re)criar os bancos de teste a cada execução.
TEST_ADMIN_DATABASE_URL=postgresql://gabarita:gabarita@localhost:5436/postgres
